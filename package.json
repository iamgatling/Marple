{
  "name": "marple",
  "version": "2.4.0",
  "description": "Self-hosted analytics package",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/cjs/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "marple": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamgatling/Marple.git"
  },
  "homepage": "https://github.com/iamgatling/Marple#readme",
  "bugs": {
    "url": "https://github.com/iamgatling/Marple/issues"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && cp src/dashboard.html dist/dashboard.html && node scripts/build-cjs.js",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test tests/*.test.js",
    "test:run": "node --test tests/*.test.js"
  },
  "dependencies": {
    "isbot": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/sqlite3": "^3.1.11",
    "express": "^5.2.1",
    "sqlite3": "^6.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "sqlite3": "^5.1.6"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "analytics",
    "privacy",
    "self-hosted",
    "marple"
  ],
  "license": "MIT"
}
