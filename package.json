{
  "name": "marple",
  "version": "1.0.0",
  "description": "Self-hosted analytics package",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js"
  },
  "bin": {
    "marple": "./src/cli.js"
  },
  "files": [
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamgatling/Marple.git"
  },
  "homepage": "https://github.com/iamgatling/Marple#readme",
  "bugs": {
    "url": "https://github.com/iamgatling/Marple/issues"
  },
  "sideEffects": false,
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --input-type=module -e \"console.log('no tests')\""
  },
  "devDependencies": {
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "sqlite3": "^5.1.6"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "analytics",
    "privacy",
    "self-hosted",
    "marple"
  ],
  "license": "MIT"
}
